<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      夜间色板 —— 与 core/theme/Color.kt 的 DarkColor 同源，改色必须两处同步。
      深色不是简单反色：主色提亮到可辨识、背景走低饱和青墨、文字提亮。
    -->

    <!-- 品牌主色：深色下主色提亮为浅青，保证在深底上可读 -->
    <color name="primary">#FF5AD1E0</color>
    <color name="primary_dark">#FF7FDCE8</color>
    <color name="primary_light">#FF5AD1E0</color>
    <color name="primary_container">#FF0B4A54</color>
    <color name="on_primary">#FF00363E</color>
    <color name="on_primary_container">#FFBDE7EC</color>

    <!-- 背景 / 表面 -->
    <color name="background">#FF0A1213</color>
    <color name="surface">#FF0F1819</color>
    <color name="input_bg">#FF182122</color>
    <color name="stroke">#FF3C4748</color>

    <!-- 文字 -->
    <color name="text_primary">#FFDDE6E6</color>
    <color name="text_secondary">#FFC0CCCD</color>
    <color name="text_hint">#FF889596</color>

    <!-- 语义色 -->
    <color name="success">#FF7DD0A0</color>
    <color name="danger">#FFF2B8B5</color>
    <color name="disabled">#FF2C3637</color>
</resources>
