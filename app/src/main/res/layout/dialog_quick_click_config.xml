<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 按钮名称 -->
        <TextView
            style="@style/ModernText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按钮名称（可选）" />

        <EditText
            android:id="@+id/etQuickName"
            style="@style/ModernEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="text"
            android:maxLength="10"
            android:hint="默认为“按钮N”" />

        <!-- 动作类型 -->
        <TextView
            style="@style/ModernText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="动作类型" />

        <RadioGroup
            android:id="@+id/rgQuickActionType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbQuickTypeText"
                style="@style/ModernRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="文本匹配" />

            <!-- Phase 1 仅支持文本匹配，其余禁用 -->
            <RadioButton
                android:id="@+id/rbQuickTypeImage"
                style="@style/ModernRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:alpha="0.5"
                android:text="图像识别（即将支持）" />

            <RadioButton
                android:id="@+id/rbQuickTypeCoord"
                style="@style/ModernRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:alpha="0.5"
                android:text="坐标点击（即将支持）" />
        </RadioGroup>

        <!-- 目标文字 -->
        <TextView
            style="@style/ModernText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="目标文字" />

        <EditText
            android:id="@+id/etQuickText"
            style="@style/ModernEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="text"
            android:hint="输入要在屏幕上匹配的文字" />

        <!-- 点击后自动收起悬浮窗（CheckBox 规避该 ROM 上 SwitchCompat 的测量崩溃） -->
        <CheckBox
            android:id="@+id/swQuickAutoCollapse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:text="点击后自动收起悬浮窗"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:buttonTint="@color/primary" />

    </LinearLayout>
</ScrollView>
