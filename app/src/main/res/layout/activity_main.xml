<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 应用图标（白色圆角容器衬托） -->
    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_card"
        android:elevation="6dp"
        android:padding="14dp"
        android:contentDescription="@string/app_name"
        android:src="@mipmap/ic_launcher" />

    <!-- 标题 -->
    <TextView
        style="@style/ModernText.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="22sp"
        android:textColor="@color/on_gradient"
        android:text="@string/app_name" />

    <TextView
        style="@style/ModernText.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/on_gradient_secondary"
        android:text="轻触悬浮窗即可自动点击" />

    <!-- 状态卡片 -->
    <LinearLayout
        style="@style/ModernCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/ModernText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前状态" />

        <TextView
            android:id="@+id/tvStatus"
            style="@style/ModernText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="请先获取所有权限" />
    </LinearLayout>

    <!-- 主操作按钮 -->
    <Button
        android:id="@+id/btnRequestPermission"
        style="@style/ModernButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:text="获取权限" />

    <Button
        android:id="@+id/btnCheckPermission"
        style="@style/ModernButton.Outline"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="刷新状态" />

    <!-- 新旧功能切换：分段开关样式（选择会持久化，默认旧功能） -->
    <LinearLayout
        android:id="@+id/modeSwitchTrack"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_mode_switch_track"
        android:padding="4dp">

        <TextView
            android:id="@+id/tvModeOld"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="连点器"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="@drawable/bg_mode_switch_thumb"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvModeNew"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="代点器"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/on_gradient"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <Button
        android:id="@+id/btnToggleService"
        style="@style/ModernButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:enabled="false"
        android:text="启动悬浮窗" />

</LinearLayout>
