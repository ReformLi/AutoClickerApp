<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      浅色色板 —— 与 core/theme/Color.kt 的 LightColor 同源，改色必须两处同步。
      命名沿用旧键位（primary / surface / input_bg / stroke ...），避免 XML 侧批量改引用。
    -->

    <!-- 品牌主色（钢青 Teal-Steel） -->
    <color name="primary">#FF0F6E7D</color>
    <color name="primary_dark">#FF0A5A68</color>
    <color name="primary_light">#FF5AD1E0</color>
    <color name="primary_container">#FFC9E9EE</color>
    <color name="on_primary">#FFFFFFFF</color>
    <color name="on_primary_container">#FF00363D</color>

    <!-- 背景 / 表面（同色相低饱和青灰，靠亮度差分层） -->
    <color name="background">#FFF3F7F8</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="input_bg">#FFF1F6F7</color>
    <color name="stroke">#FFC3CFD0</color>

    <!-- 文字 -->
    <color name="text_primary">#FF16201F</color>
    <color name="text_secondary">#FF465456</color>
    <color name="text_hint">#FF6B7879</color>

    <!-- 语义色 -->
    <color name="success">#FF1B7A4B</color>
    <color name="danger">#FFB3261E</color>
    <color name="disabled">#FFDCE4E5</color>
</resources>
