<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AutoClickerApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 统一色板：主色蓝 -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorOnSecondary">@color/on_primary</item>

        <!-- 背景 / 表面 -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/stroke</item>

        <!-- 状态栏与深蓝渐变顶部同色，图标用白色 -->
        <item name="android:statusBarColor">@color/status_bar_top</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- 全局默认按钮样式 -->
        <item name="materialButtonStyle">@style/ModernButton</item>
    </style>

    <style name="Theme.AutoClickerApp" parent="Base.Theme.AutoClickerApp" />
</resources>
